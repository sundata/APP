# Copy to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=
# postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/CONNECTION_NAME
DATABASE_URL=
CLOUD_SQL_CONNECTION_NAME=
SQLITE_PATH=./furinnews.db
# Comma-separated list of origins allowed to call this API from a browser.
ALLOWED_ORIGINS=
# Shared token required by maintenance endpoints (/v1/crawl, /v1/backfill-images, ...).
ADMIN_API_TOKEN=
APP_STORE_SHARED_SECRET=
